set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT DEFINED ENV{MINGW_ROOT})
  message(FATAL_ERROR "Defina MINGW_ROOT como o prefixo da toolchain MinGW (por exemplo /usr)")
endif()
set(CMAKE_CXX_COMPILER "$ENV{MINGW_ROOT}/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_FIND_ROOT_PATH "$ENV{MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
